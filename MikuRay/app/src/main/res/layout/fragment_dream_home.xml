<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dream_bg"
    android:orientation="horizontal">

    <!-- 左侧窄边栏 -->
    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="36dp">

        <TextView
            android:id="@+id/dream_home_date_mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dream_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <View
            android:layout_width="22dp"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#40000000" />

        <TextView
            android:id="@+id/dream_home_date_dd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dream_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/dream_battery_track">

            <View
                android:id="@+id/dream_home_battery_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@drawable/dream_battery_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/dream_home_battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/dream_text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="22dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="#40000000" />

        <ImageButton
            android:id="@+id/dream_home_shortcut_proxy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dream_tab_proxy"
            android:src="@drawable/rmx_arrows_arrow_up_down_line"
            app:tint="@color/dream_text_primary" />

        <ImageButton
            android:id="@+id/dream_home_shortcut_config"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dream_tab_config"
            android:src="@drawable/rmx_system_apps_line"
            app:tint="@color/dream_text_primary" />

        <ImageButton
            android:id="@+id/dream_home_shortcut_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dream_tab_settings"
            android:src="@drawable/rmx_system_settings_3_line"
            app:tint="@color/dream_text_primary" />
    </LinearLayout>

    <!-- 右侧内容 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <ImageView
            android:id="@+id/dream_home_orb"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:contentDescription="@null"
            android:src="@drawable/dream_orb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UP"
                    android:textColor="#9E6E8380"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dream_home_up_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/dream_text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dream_home_up_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/dream_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOWN"
                    android:textColor="#9E6E8380"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dream_home_down_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/dream_text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dream_home_down_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/dream_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dream_home_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/dream_home_node_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/dream_no_server_selected"
                android:textColor="@color/dream_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/dream_home_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dream_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/dream_home_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#8E6E8380"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dream_home_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dream_home_subtitle"
            android:textColor="@color/dream_text_primary"
            android:textSize="22sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/dream_home_connect_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/dream_pill_teal"
            android:text="@string/dream_connect"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
