<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dream_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/dream_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/dream_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dream_card"
        app:itemIconTint="@color/dream_nav_item_color"
        app:itemTextColor="@color/dream_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/dream_bottom_nav" />

</LinearLayout>
