<?xml version="1.0" encoding="utf-8"?>
<!-- 发光球：强光晕 + 多层立体球体（左上高光） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层光晕 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#5912836E"
                android:centerColor="#1F12836E"
                android:endColor="#0012836E" />
        </shape>
    </item>
    <!-- 球体：左上高光 → 过渡 → 深色边缘 -->
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="0.36"
                android:centerY="0.28"
                android:startColor="#FDFEFF"
                android:centerColor="#C2C9D5"
                android:endColor="#767F8C" />
        </shape>
    </item>
    <!-- 左上高光点 -->
    <item
        android:left="52dp"
        android:top="36dp"
        android:width="80dp"
        android:height="80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#E6FFFFFF"
                android:centerColor="#80FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
